generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  learner
  admin
}

enum GrammarStatus {
  not_started
  in_progress
  completed
}

enum DifficultyLevel {
  easy
  medium
  hard
}

enum QuizType {
  vocabulary
  grammar
}

enum VocabularyProgressStatus {
  learned
  review
}

model User {
  id                 String                   @id @default(uuid())
  fullName           String                   @map("full_name")
  email              String                   @unique
  passwordHash       String                   @map("password_hash")
  role               UserRole                 @default(learner)
  sessions           AuthSession[]
  vocabularyProgress UserVocabularyProgress[]
  quizAttempts       QuizAttempt[]
  activityLogs       ActivityLog[]
  chatLogs           ChatLog[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_sessions")
}

model Vocabulary {
  id                 Int                      @id
  japanese           String
  hiragana           String
  romaji             String
  vietnamese         String
  type               String
  topic              String
  exampleJapanese    String                   @map("example_japanese")
  exampleVietnamese  String                   @map("example_vietnamese")
  userProgress       UserVocabularyProgress[]
  knowledgeChunks    KnowledgeChunk[]
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  @@map("vocabulary")
}

model Grammar {
  id                 Int              @id
  pattern            String
  meaning            String
  structure          String
  usageNote          String           @map("usage_note")
  exampleJapanese    String           @map("example_japanese")
  exampleVietnamese  String           @map("example_vietnamese")
  difficulty         DifficultyLevel
  status             GrammarStatus    @default(not_started)
  knowledgeChunks    KnowledgeChunk[]
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@map("grammar")
}

model QuizQuestion {
  id              Int              @id
  question        String
  type            QuizType
  difficulty      DifficultyLevel
  topic           String
  correctAnswer   String           @map("correct_answer")
  explanation     String
  answers         QuizAnswer[]
  knowledgeChunks KnowledgeChunk[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("quiz_questions")
}

model QuizAnswer {
  id          String       @id @default(uuid())
  questionId  Int          @map("question_id")
  answerKey   String       @map("answer_key")
  answerText  String       @map("answer_text")
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, answerKey])
  @@map("quiz_answers")
}

model UserVocabularyProgress {
  userId         String                   @map("user_id")
  vocabularyId   Int                      @map("vocabulary_id")
  status         VocabularyProgressStatus
  lastReviewedAt DateTime?                @map("last_reviewed_at")
  nextReviewAt   DateTime?                @map("next_review_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabulary     Vocabulary               @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)

  @@id([userId, vocabularyId])
  @@map("user_vocabulary_progress")
}

model QuizAttempt {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  quizType   QuizType @map("quiz_type")
  score      Int
  total      Int
  percentage Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("quiz_attempts")
}

model ActivityLog {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  type            String
  content         String
  topic           String?
  result          String?
  score           Int?
  durationMinutes Int?     @map("duration_minutes")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model ChatLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  message     String
  answer      String
  provider    String
  sourcesJson Json?    @map("sources_json")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("chat_logs")
}

model KnowledgeChunk {
  id           String        @id @default(uuid())
  sourceType   String        @map("source_type")
  sourceId     String        @map("source_id")
  title        String
  content      String
  embedding    Json?
  vocabularyId Int?          @map("vocabulary_id")
  grammarId    Int?          @map("grammar_id")
  quizId       Int?          @map("quiz_id")
  vocabulary   Vocabulary?   @relation(fields: [vocabularyId], references: [id], onDelete: Cascade)
  grammar      Grammar?      @relation(fields: [grammarId], references: [id], onDelete: Cascade)
  quiz         QuizQuestion? @relation(fields: [quizId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([sourceType, sourceId])
  @@map("knowledge_chunks")
}
